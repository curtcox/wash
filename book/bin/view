#!/usr/bin/env python3
"""view — render an SDT notebook conversation as an HTML page.

Declared `parse-mode raw`, so the runtime hands it the remaining URL suffix as a
single argument, e.g. `notebook/0/2/0`. For this demo view always renders the
whole conversation under notebook/0 (and offers a box to continue it); the
specific leaf in the URL just confirms where `ask` landed you.
"""
from __future__ import annotations

import html
import os
import sys

ORD = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
CONV = os.path.join("notebook", "0")  # cwd is the wash root

PAGE = """<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<title>Notebook</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
 body{{font:16px/1.5 -apple-system,Segoe UI,Roboto,sans-serif;max-width:46rem;
   margin:2rem auto;padding:0 1rem;color:#1a1a1a}}
 a{{color:#0a58ca}}
 .turn{{margin:1.2rem 0;padding:.2rem 0;border-top:1px solid #eee}}
 .q{{font-weight:600}}
 .a{{margin:.3rem 0;white-space:pre-wrap}}
 .addr{{font:13px ui-monospace,Menlo,monospace;color:#888}}
 textarea{{width:100%;font:inherit;padding:.5rem;box-sizing:border-box}}
 button{{font:inherit;padding:.4rem 1rem;margin-top:.4rem;cursor:pointer}}
 .nav{{font:13px ui-monospace,Menlo,monospace;color:#888;margin-bottom:1rem}}
</style></head><body>
<div class="nav"><a href="/">&larr; home</a> &middot;
  <a href="/render/ch01.md">Chapter 1</a></div>
<h1>Notebook</h1>
{turns}
<h2>Continue</h2>
<form onsubmit="return send(event)">
  <textarea id="msg" rows="3" placeholder="Ask something, e.g. What is 2+2?"></textarea>
  <div><button>Send</button></div>
</form>
<script>
async function send(e){{
  e.preventDefault();
  const t=document.getElementById('msg').value;
  const r=await fetch('/ask',{{method:'POST',body:t}});
  const url=(await r.text()).trim();
  if(url) window.location=url;
  return false;
}}
</script>
</body></html>
"""


def read(path: str) -> str:
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def main() -> int:
    turns_html = []
    if os.path.isdir(CONV):
        children = sorted(
            (e for e in os.listdir(CONV)
             if len(e) == 1 and e in ORD and os.path.isdir(os.path.join(CONV, e))),
            key=lambda e: ORD.index(e),
        )
        for n in children:
            q = read(os.path.join(CONV, n, "a"))
            a = read(os.path.join(CONV, n, "0", "a"))
            turns_html.append(
                f'<div class="turn">'
                f'<div class="q">{html.escape(q)}</div>'
                f'<div class="a">{html.escape(a)}</div>'
                f'<div class="addr">/notebook/0/{n}/a &rarr; /notebook/0/{n}/0/a</div>'
                f"</div>"
            )
    if not turns_html:
        turns_html.append("<p><em>No turns yet. Ask something below.</em></p>")

    sys.stdout.write(PAGE.format(turns="\n".join(turns_html)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
