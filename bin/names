#!/usr/bin/env python3
import json
from pathlib import Path

findings = []
for c_file in Path.cwd().rglob("c"):
    if not c_file.is_file():
        continue
    seen = set()
    for lineno, raw in enumerate(c_file.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        parts = stripped.split()
        location = f"{c_file.relative_to(Path.cwd())}:{lineno}"
        if len(parts) < 2:
            findings.append({"severity": "warning", "location": location, "message": "malformed c entry"})
            continue
        if parts[0] in seen:
            findings.append({"severity": "info", "location": location, "message": f"duplicate name {parts[0]!r}; last wins"})
        seen.add(parts[0])
print(json.dumps({"findings": findings}, indent=2))
