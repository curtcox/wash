#!/usr/bin/env python3
import json
import sys
from pathlib import Path

bundle_root = Path(__file__).resolve().parents[1]
sdt_path = bundle_root / "tools" / "sdt"
if sdt_path.is_dir():
    sys.path.insert(0, str(sdt_path))
vendor_path = bundle_root / "ui" / "vendor"
if vendor_path.is_dir():
    sys.path.insert(0, str(vendor_path))

try:
    from sdt.lint import lint_tree
except ImportError:
    from sdt_support import lint_tree

findings = [finding.__dict__ for finding in lint_tree(Path.cwd())]
print(json.dumps({"findings": findings}, indent=2))
