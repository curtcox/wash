#!/usr/bin/env python3
import json
import sys
from pathlib import Path

needle = sys.argv[1] if len(sys.argv) > 1 else ""
matches = []
if needle:
    for path in Path.cwd().rglob("a"):
        if path.is_file():
            text = path.read_text(encoding="utf-8", errors="ignore")
            if needle in text:
                matches.append({"path": str(path.relative_to(Path.cwd())), "line": text.find(needle)})
print(json.dumps({"query": needle, "matches": matches[:100]}, indent=2))
