#!/usr/bin/env python3
import json
import sys
from pathlib import Path

bundle_root = Path(__file__).resolve().parents[1]
sdt_path = bundle_root / "tools" / "sdt"
if sdt_path.is_dir():
    sys.path.insert(0, str(sdt_path))
vendor_path = bundle_root / "ui" / "vendor"
if vendor_path.is_dir():
    sys.path.insert(0, str(vendor_path))

try:
    from sdt.write import SdtWriteError, add_node
except ImportError:
    from sdt_support import SdtWriteError, add_node

parent = Path.cwd() / (sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] else ".")
body = sys.stdin.buffer.read()
try:
    created = add_node(parent, body)
except SdtWriteError as exc:
    print(json.dumps({"error": str(exc)}))
    raise SystemExit(2)

rel = created.path.relative_to(Path.cwd()).as_posix()
print(
    json.dumps(
        {
            "manifest": "Created Node",
            "created": rel,
            "location": f"/{rel}",
            "ordinal": created.ordinal,
        },
        indent=2,
    )
)
