#!/usr/bin/env python3
from pathlib import Path
import sys

scope = Path.cwd() / (sys.argv[1] if len(sys.argv) > 1 else ".")
name = sys.argv[2] if len(sys.argv) > 2 else ""
target = sys.argv[3] if len(sys.argv) > 3 else ""
c_file = scope / "c"
lines = []
if c_file.is_file():
    lines = [line for line in c_file.read_text(encoding="utf-8").splitlines() if not line.split() or line.split()[0] != name]
lines.append(f"{name} {target}")
c_file.write_text("\n".join(lines) + "\n", encoding="utf-8")
print("ok")
