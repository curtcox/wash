# wash-fixture: outside-bin
#!/bin/sh
. "$(dirname "$0")/_common.sh"
_wash_read_stdin
argv_str=$(_wash_argv_str "$@")
_wash_split_records | while IFS= read -r line; do
    case "$line" in
        *"$_WASH_SEP"*)
            record=${line%"$_WASH_SEP"}
            _wash_emit_tagged "$(basename "$0")" "$argv_str" "$record"

            ;;
    esac
done
